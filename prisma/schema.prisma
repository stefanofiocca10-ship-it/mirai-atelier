generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Albero categorie: zona (parent null) → sottotipo (leaf).
/// kind = PIERCING | JEWELRY. Un prodotto può stare su più leaf.
model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  kind        String
  zone        String
  description String?
  sortOrder   Int               @default(0)
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([kind])
  @@index([zone])
  @@index([parentId])
  @@index([sortOrder])
}

model Product {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  material    String?
  status      String            @default("DISPONIBILE")
  /// Cover: prima foto (sincronizzata con ProductImage sortOrder 0)
  imageUrl    String?
  /// Pezzi fisici in atelier (0 = non tracciato / da aggiornare)
  quantity    Int               @default(0)
  featured    Boolean           @default(false)
  sortOrder   Int               @default(0)
  categories  ProductCategory[]
  images      ProductImage[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([featured])
  @@index([sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  /// PIERCING | TATTOO | JEWELRY
  type      String   @default("PIERCING")
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([featured])
  @@index([sortOrder])
}

/// Appuntamenti calendario pubblico (ospiti) — gestiti da admin /calendario
model Appointment {
  id        String    @id @default(cuid())
  title     String?
  guestName String?
  startsAt  DateTime
  endsAt    DateTime?
  status    String    @default("PREVISTO")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startsAt])
  @@index([status])
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  serviceType String
  preferredAt DateTime?
  message     String?
  status      String   @default("NUOVA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
